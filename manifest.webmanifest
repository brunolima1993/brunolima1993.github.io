{
  "id": "/",
  "name": "TMy Car — Manutenção do carro",
  "short_name": "TMyCar",
  "description": "Manutenção na palma da mão. Cadastre seu carro uma vez e o app cuida das datas: óleo, filtros, correia, freio e arrefecimento.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#03060D",
  "theme_color": "#06122B",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": ["auto", "productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png",     "sizes": "192x192",   "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png",     "sizes": "512x512",   "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192",   "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512",   "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-1024.png",    "sizes": "1024x1024", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Minha garagem",
      "short_name": "Garagem",
      "url": "./?tela=garagem",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
